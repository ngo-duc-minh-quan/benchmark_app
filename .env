# BenchmarkX Native — Environment Variables
# Đổi URL này tương ứng với môi trường của bạn

# ── Local Development ──────────────────────────────────────
# Thay 192.168.x.x bằng IP thực của máy tính chạy Next.js
# (Mở cmd > ipconfig > tìm IPv4 Address)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# ── Production (Vercel) ────────────────────────────────────
# Uncomment sau khi deploy Next.js lên Vercel:
EXPO_PUBLIC_API_URL=https://benchmark-tool-xi.vercel.app

# ── Local Alias ────────────────────────────────────────────
EXPO_PUBLIC_API_URL_LOCAL=http://localhost:3000
