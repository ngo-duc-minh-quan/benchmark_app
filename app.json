{
  "expo": {
    "name": "BenchmarkX",
    "slug": "benchmarkx-native",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benchmarkx.app",
      "infoPlist": {
        "UIRequiresPersistentWifi": false
      }
    },
    "android": {
      "package": "com.benchmarkx.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#050A18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050A18"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "allowBackup": false
          }
        }
      ],
      "./plugins/withHighRefreshRate",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "0085ddd3-e49a-438b-a629-262645e137f9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0085ddd3-e49a-438b-a629-262645e137f9"
    }
  }
}
